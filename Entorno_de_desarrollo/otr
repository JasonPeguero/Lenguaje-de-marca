<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <title>Transiciones en imágenes</title>
  <style>

    /* Otra opción: animar opacidad y borde redondeado */
    .mi-imagen-fade {
      transition: opacity 0.4s ease, border-radius 0.4s ease;
      opacity: 1;
    }
    .mi-imagen-fade:hover {
      opacity: 0.9;
      border-radius: 12px;
    }
  </style>
</head>
<body>

  <h1>Transiciones en imágenes</h1>
  <!-- Ejemplo de opacidad/borde -->
    <img class="mi-imagen-fade" src="assets\img\_fondo.jpg" alt="Opacidad">
<a class="mi-imagen-fade" href="assets\img\_fondo.jpg"></a>
</body>
</html>